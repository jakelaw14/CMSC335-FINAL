<!DOCTYPE html>
<html>
<head>
    <title>Saved Players</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>

<h1>Saved NBA Players</h1>
<a href="/">Add Another Player</a>
<hr>

<% players.forEach(p => { %>
    <div>
        <h2><%= p.name %></h2>
        <p>Position: <%= p.position %></p>
        <p>Height: <%= p.height %></p>
        <p>Weight: <%= p.weight %></p>
        <p>Team: <%= p.team %></p>
        <p>ID: <%= p.idNumber %></p>
    </div>
    <hr>
<% }) %>

</body>
</html>
